# Ignore all files by default
*

# Include codebase directories
!cmd/
!internal/
!db/

# Include Go module files
!go.mod
!go.sum

# Include Dockerfile
!Dockerfile

# Include .git so `go build` can auto-stamp the binary with vcs.revision /
# vcs.time (exposed via GET /v1/version), see internal/api/version.go
!.git/
