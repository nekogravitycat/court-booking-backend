# Mirror .gitignore: exclude local/secret artifacts, include everything else
# (including .git). A full tracked-tree + .git copy lets `go build` accurately
# embed vcs.revision/vcs.time/vcs.modified, exposed via GET /v1/version.
.env

# Local storage for uploaded files
/storage/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test
*.out

# MacOS files
.DS_Store

ref-only/
