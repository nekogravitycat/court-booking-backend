# One of: local, dev, prod. Anything else fails at startup.
# prod additionally requires PROD_ORIGINS (comma-separated allowed CORS origins).
APP_ENV=local
# PROD_ORIGINS=https://example.com
HTTP_ADDR=:8080

DB_DSN=postgres://user_postgres:password_postgres@localhost:5432/court_booking?sslmode=disable
TEST_DB_DSN=postgres://user_postgres:password_postgres@localhost:5432/court_booking_test?sslmode=disable

# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-data
TEST_JWT_SECRET=test-secret-replace-me-with-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=1h

POSTGRES_USER=user_postgres
POSTGRES_PASSWORD=password_postgres
POSTGRES_DB=court_booking
POSTGRES_TEST_DB=court_booking_test

CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
